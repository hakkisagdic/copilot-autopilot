{
  "release-type": "node",
  "changelog-type": "github",
  "include-commit-authors": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "pull-request-header": ":robot: Release notes",
  "pull-request-footer": "This release was generated automatically by release-please.",
  "packages": {
    ".": {
      "release-type": "node"
    }
  }
}

